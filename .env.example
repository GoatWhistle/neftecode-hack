# Режим деплоя с агентным слоем и LLM.
AGENTIC_DECISION_ENABLED=1
LLM_PROVIDER=zai
API_KEY=replace-with-your-key
ZAI_MODEL=glm-5.3-flash

# Общие параметры запроса к LLM.
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0
AGENT_TIMEOUT_SECONDS=180

# Порт веб-интерфейса Docker.
CUTPOINT_PORT=8080

# Для полностью детерминированного режима без LLM замените настройки выше на:
# AGENTIC_DECISION_ENABLED=0
# LLM_PROVIDER=scripted
# API_KEY=
