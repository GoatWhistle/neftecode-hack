# Набор переменных для защиты: короткое ожидание провайдера, чтобы демонстрация не стояла минуты.
# Скопировать в .env (ключ добавить руками, .env не коммитится) или экспортировать перед запуском.
# Замер 18.09: сеть, глотающая пакеты (поведение заводского firewall), при умолчаниях 120 с × 2 попытки
# даёт 241 с на один вызов модели; с этим набором отказ провайдера обнаруживается за 30 с.

LLM_PROVIDER=zai                 # zai | openai | anthropic | local | scripted
LLM_REQUEST_TIMEOUT_SECONDS=30   # одна попытка запроса к модели (умолчание 120)
LLM_MAX_RETRIES=0                # без повторов (умолчание 1); повтор укладывается в дедлайн агента
AGENT_TIMEOUT_SECONDS=180        # бюджет одного решения (умолчание 600); страница ждёт +60 с
# Без сети (закрытая сеть завода): OpenAI-совместимая модель внутри периметра или детерминированная политика.
# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:14b
# LLM_PROVIDER=scripted
